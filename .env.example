# Copy this file to .env for local testing.
# In production, these live as GitHub Actions secrets — never commit a real .env file.

# LLM (topic + script + metadata generation)
LLM_PROVIDER=anthropic          # or "openai"
LLM_API_KEY=
# Optional override, e.g. "claude-sonnet-4-5-20250929" or "gpt-4o-mini"
LLM_MODEL=

# Text-to-speech
TTS_PROVIDER=elevenlabs         # or "openai"
TTS_API_KEY=
# elevenlabs: a voice ID from your ElevenLabs voice library.
# openai: a preset voice name, e.g. "alloy".
TTS_VOICE_ID=
# Optional override, e.g. "eleven_multilingual_v2" or "gpt-4o-mini-tts"
TTS_MODEL=

# Stock media
PEXELS_API_KEY=
# PIXABAY_API_KEY=              # optional secondary source

# Optional: AI image generation fallback (used when no good stock match exists,
# or when script_writer.py flags a fact as prefer_ai_visual)
IMAGE_GEN_PROVIDER=replicate    # or "openai"
# replicate: an API token from replicate.com/account/api-tokens
# openai: an OpenAI API key (note: dall-e-3 is deprecated on newer
# accounts/projects — check `client.models.list()` if unsure which image
# models your account has access to)
IMAGE_GEN_API_KEY=
# Optional override — defaults to black-forest-labs/flux-schnell (replicate)
# or gpt-image-1 (openai)
IMAGE_GEN_MODEL=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Pipeline behavior
UPLOAD_VISIBILITY=private        # private | unlisted | public — start on "private" during the approval-gate phase
REQUIRE_MANUAL_APPROVAL=true     # if true, orchestrator stops before upload and waits for a human check
# Only set true if a video would count as YouTube's "altered or synthetic
# content" (realistic depiction of real people/places/events) — TTS
# narration over stock/illustrative AI images does not qualify. See
# pipeline/config.py for details.
CONTAINS_SYNTHETIC_MEDIA=false
